# ─────────────────────────────────────────────────────────────────────
# Frontend (apps/web). Em dev rode `cp .env.example .env.local`.
# Em produção (Vercel) configure tudo abaixo no dashboard:
#   Settings > Environment Variables.
# ─────────────────────────────────────────────────────────────────────

# URL do frontend (ele mesmo). Em dev é localhost; em prod é o domínio Vercel
# ou seu domínio custom. NextAuth usa pra montar callbacks.
NEXTAUTH_URL=http://localhost:3001

# Segredo aleatório (ex.: `openssl rand -base64 32`). Obrigatório.
NEXTAUTH_SECRET=

# Credenciais do dono do dashboard (single-user).
OWNER_EMAIL=admin@example.com
# Use B64 porque @next/env expande $ em valores .env (corrompe hashes bcrypt).
# Gerar com:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('SUA_SENHA', 10)).toString('base64'))"
OWNER_PASSWORD_HASH_B64=

# URL pública da API (Fastify rodando na sua VPS). Use o MESMO valor nas duas
# vars abaixo. Em produção troque pra HTTPS apontando pro reverse proxy:
#   API_BASE_URL=https://api.seu-dominio.com.br
#   NEXT_PUBLIC_API_BASE_URL=https://api.seu-dominio.com.br
API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
