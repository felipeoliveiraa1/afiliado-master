generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceKind {
  SHOPEE
  AMAZON
  MERCADOLIVRE
  PROMOBIT
}

enum ChannelKind {
  WHATSAPP_GROUP
  TELEGRAM_CHANNEL
}

enum DispatchStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum UserRole {
  OWNER
  ADMIN
}

model Source {
  id                String     @id @default(cuid())
  kind              SourceKind @unique
  enabled           Boolean    @default(true)
  config            Json       @default("{}")
  cookieHealth      Json?
  cookieValidatedAt DateTime?
  lastFetchAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  offers            Offer[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Configurações do sistema editáveis pelo dashboard.
/// Cada `key` mapeia uma seção (ex: "evolution", "shopee_panel", "antiban").
/// Valores ficam em `value` JSON pra flexibilidade. Backend lê com cache + fallback pro env.
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@index([key])
}

model Offer {
  id             String     @id @default(cuid())
  source         Source     @relation(fields: [sourceId], references: [id])
  sourceId       String
  externalId     String
  title          String
  description    String?
  imageUrl       String?
  price          Decimal    @db.Decimal(12, 2)
  originalPrice  Decimal?   @db.Decimal(12, 2)
  discountPct    Float?
  category       String?
  url            String
  affiliateUrl   String?
  commissionPct  Float?
  coupon         String?
  installments   Int?
  rating          Float?
  ratingCount     Int?
  salesCount      Int?
  score          Float?
  fetchedAt      DateTime   @default(now())
  expiresAt      DateTime?
  raw            Json       @default("{}")
  variants       Variant[]
  dispatches     Dispatch[]

  @@unique([sourceId, externalId])
  @@index([fetchedAt])
  @@index([discountPct])
  @@index([score])
}

model Variant {
  id        String   @id @default(cuid())
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId   String
  channelKind ChannelKind
  caption   String
  hashtags  String[]
  urgency   String?
  promptHash String
  createdAt DateTime @default(now())

  @@index([offerId, channelKind])
  @@index([promptHash])
}

model Channel {
  id           String      @id @default(cuid())
  kind         ChannelKind
  name         String
  // For WhatsApp: Evolution instance name + group JID
  evolutionInstance String?
  whatsappGroupId  String?
  // For Telegram: bot token + chat id (futuro)
  telegramBotToken String?
  telegramChatId   String?
  enabled      Boolean     @default(true)
  dailySent    Int         @default(0)
  lastResetAt  DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  campaigns    Campaign[]  @relation("CampaignChannels")
  dispatches   Dispatch[]
}

model Campaign {
  id          String     @id @default(cuid())
  name        String
  enabled     Boolean    @default(true)
  // Filtros (Json para flexibilidade): { categories?, minDiscount?, minScore?, sources?, maxPrice? }
  filters     Json       @default("{}")
  // Schedule: cron expression OR { intervalMinutes: number }
  schedule    Json       @default("{}")
  channels    Channel[]  @relation("CampaignChannels")
  niches      Niche[]    @relation("CampaignNiches")
  dispatches  Dispatch[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Dispatch {
  id          String         @id @default(cuid())
  campaign    Campaign       @relation(fields: [campaignId], references: [id])
  campaignId  String
  offer       Offer          @relation(fields: [offerId], references: [id])
  offerId     String
  channel     Channel        @relation(fields: [channelId], references: [id])
  channelId   String
  status      DispatchStatus @default(PENDING)
  scheduledFor DateTime
  sentAt      DateTime?
  externalMsgId String?
  errorMessage String?
  clickCount  Int            @default(0)
  createdAt   DateTime       @default(now())

  @@unique([campaignId, offerId, channelId])
  @@index([status, scheduledFor])
}

/// Cupons do programa de afiliados do Mercado Livre.
/// Lista vem do scrape do HTML de /afiliados/coupons (campo
/// `availableCouponsData.coupons`). Após gerar via POST /create-code,
/// guardamos `alias` (#PREFIXOSUFIXO) que é o código que vai pro
/// comprador. Sync periódico atualiza `remainingBudget` e `status`.
model MlCoupon {
  id              String   @id @default(cuid())
  mlCouponId      Int      @unique
  alias           String?  // ex: "#PRECORADARADARHOJE" — só após generate
  code            String?  // sufixo escolhido pelo afiliado: "RADARHOJE"
  prefix          String?  // prefixo do afiliado: "PRECORADA"
  title           String   // "R$ 30 OFF" ou "25% OFF"
  seller          String   // "Darklab"
  category        String   // "PRODUCT_DISCOUNT"
  remainingBudget Float
  expirationDate  DateTime
  status          String   @default("AVAILABLE") // AVAILABLE | ACTIVE | EXPIRED | EXHAUSTED
  enabled         Boolean  @default(true)
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([seller, enabled, status])
}

/// Cupons Shopee cadastrados manualmente. Diferente do MlCoupon porque
/// Open API Shopee NÃO expõe códigos — afiliado recebe via email/app e
/// cola aqui. Match automático com offer.raw.seller no dispatcher.
/// Cupons Shopee — modelo inspirado no DivulgaLinks.
/// Sistema calcula o preço final aplicando type/value/maxDiscount/minPurchase.
/// `code` opcional: vazio = cupom aplicado AUTO no checkout, preenchido = digitável.
model ShopeeCoupon {
  id            String    @id @default(cuid())
  code          String?   @unique  // null = automático; preenchido = digitável
  description   String?
  /// 'PERCENT' (25 = 25%) ou 'FIXED' (35 = R$35 fixo)
  type          String    @default("PERCENT")
  /// Número: 25 quando PERCENT, ou 35 quando FIXED
  value         Float     @default(0)
  /// Compra mínima pra cupom valer (R$). null = sem mínimo
  minPurchase   Float?
  /// Teto do desconto pra cupons %. Ex: cupom 25% mas máx R$10 → cap em R$10
  maxDiscount   Float?
  /// Display textual livre (ex: "25% off limitado a R$10"). Opcional.
  discountText  String?
  seller        String?
  imageUrl      String?
  validUntil    DateTime?
  enabled       Boolean   @default(true)
  /// Quando true, só aplica em Lojas Oficiais (Shopee Mall). Default false.
  officialOnly  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled, validUntil])
}

/// Nicho = preset reutilizável de filtros (categorias por marketplace +
/// keywords + filtros de qualidade). Atribuído a 1+ campanhas — permite ter
/// grupo "Mães" só com nicho Bebê + grupo "Tudo" com Bebê+Casa+Beleza.
///
/// filters JSON shape:
///   {
///     categoryIds: { SHOPEE: ["100068"], MERCADOLIVRE: ["MLB1384"], AMAZON: [] },
///     keywords: ["carrinho bebe", "fralda"],
///     minDiscount?: 20,
///     minScore?: 0.5,
///     maxPrice?: 500
///   }
model Niche {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  icon        String?    // emoji ex "🍼"
  filters     Json       @default("{}")
  enabled     Boolean    @default(true)
  campaigns   Campaign[] @relation("CampaignNiches")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
