# --- App ---
NODE_ENV=development
# Dentro do Docker (compose isolado) a API força PORT=3000 — não use 3047 aqui (3047 é só no host).
PORT=3000
LOG_LEVEL=info
# true = só HTTP, sem workers BullMQ nem cron (útil se Redis estiver instável).
# API_DISABLE_BACKGROUND=false

# --- Docker isolado na VPS (docker-compose.isolated.yml) ---
# Troque o nome do projeto se já existir outro stack com o mesmo prefixo:
#   COMPOSE_PROJECT_NAME=afiliado-master
# API exposta em 127.0.0.1:3047 (fixo no docker-compose.isolated.yml; não depende deste .env).
# Dentro dos containers use hostnames postgres e redis (não localhost):
#   DATABASE_URL=postgresql://afiliado:changeme@postgres:5432/afiliado_master?schema=public
#   REDIS_HOST=redis

# --- Postgres ---
# Opção A — Postgres no Docker (docker-compose.isolated.yml): host "postgres"
POSTGRES_USER=afiliado
POSTGRES_PASSWORD=changeme
POSTGRES_DB=afiliado_master
DATABASE_URL=postgresql://afiliado:changeme@localhost:5432/afiliado_master?schema=public

# Opção B — Supabase (use docker-compose.supabase.yml; remova Postgres local do compose).
# Dashboard: Project Settings > Database > Connection string > URI
# Recomendado para prisma migrate deploy: "Direct connection" (host db.<ref>.supabase.co, porta 5432).
# Ex.: postgresql://postgres.<PROJECT_REF>:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?schema=public
# (o host exato vem do painel — copie a URI e substitua [YOUR-PASSWORD] pela senha do banco)
# Se usar "Transaction pool" (porta 6543), consulte a doc Prisma + PgBouncer; para começo use direct 5432.

# --- Redis ---
# Docker (isolated ou supabase compose): REDIS_HOST=redis
# Dev local sem Docker: REDIS_HOST=localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Evolution API (já rodando externamente) ---
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=coloque-sua-apikey-global
# Default instance name; pode rodar múltiplas (chips) cadastrando na tabela Channel
EVOLUTION_DEFAULT_INSTANCE=afiliado-master-1

# --- OpenAI (curador / copy) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Marketplaces ---
# --- Shopee — caminho A: Open API (preferido, requer aprovação) ---
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# --- Shopee — caminho B: Auto-gerador de shortlink via painel (cookie) ---
# RISCO: usar cookie do painel pra gerar links automaticamente pode ser
# detectado pela Shopee. Defaults conservadores aplicados (poucos req/dia,
# jitter alto, janela horária). Se a Open API liberar, desligue e use SHOPEE_*.
SHOPEE_PANEL_AUTO_ENABLED=false
# Cole aqui o cookie completo da sessão logada em affiliate.shopee.com.br
# Como pegar: F12 > Application > Cookies > copia tudo como "k=v; k=v"
SHOPEE_PANEL_COOKIE=
# Endpoint interno descoberto via HAR — preencher após HAR analysis (ver README)
SHOPEE_PANEL_GENERATE_ENDPOINT=
# CSRF token (alguns painéis exigem) — vem junto no HAR
SHOPEE_PANEL_CSRF_TOKEN=
# Limites anti-detecção
SHOPEE_PANEL_DAILY_LIMIT=25
SHOPEE_PANEL_MIN_INTERVAL_SEC=45
SHOPEE_PANEL_MAX_INTERVAL_SEC=180

# --- Apify (scraping confiável Amazon BR + ML) ---
APIFY_TOKEN=
APIFY_AMAZON_ACTOR=junglee~amazon-bestsellers-scraper
APIFY_MERCADOLIVRE_ACTOR=apify~mercadolibre-scraper

# Amazon Associados — só precisa da tag (link manual ?tag=)
AMAZON_AFFILIATE_TAG=seu-tag-20

# Mercado Livre — sem API de afiliados.
# Opção 1 (default): cadastra link tageado por SKU no painel ML e cola aqui via API
# Opção 2: cookie da sessão logada para gerar links automaticamente (panel mode)
MERCADOLIVRE_AFFILIATE_TAG=
MERCADOLIVRE_SESSION_COOKIE=

# --- Mercado Livre — modo de scraper ---
# public-api (default): api.mercadolibre.com — sem risco, cobertura limitada
# apify: actor do Apify rodando browser real — captura ofertas relâmpago, Clube ML,
#        bestsellers, vitrines de promoção. Sem risco de ban (não usa nossa conta).
MERCADOLIVRE_SCRAPER=public-api
# URLs separadas por vírgula. Ex.:
# https://www.mercadolivre.com.br/ofertas,https://www.mercadolivre.com.br/mais-vendidos
MERCADOLIVRE_APIFY_START_URLS=

# --- Mercado Livre — caminho B: cookie hijacking do painel afiliados-home ---
# RISCO: usar cookie do painel pra gerar links automaticamente pode ser detectado
# pelo Mercado Livre. Defaults conservadores aplicados.
MERCADOLIVRE_PANEL_AUTO_ENABLED=false
# Cookie completo da sessão logada em https://www.mercadolivre.com.br/afiliados/hub
# Como pegar: F12 > Application > Cookies > www.mercadolivre.com.br > copiar todos como string "name=value; name2=value2".
MERCADOLIVRE_PANEL_COOKIE=
# Etiqueta (sub-id) padrão para gerar shortlinks. Vazio = usa a etiqueta principal
# detectada no HTML do hub (geralmente ofpXXXXX).
MERCADOLIVRE_PANEL_DEFAULT_TAG=
MERCADOLIVRE_PANEL_DAILY_LIMIT=30
MERCADOLIVRE_PANEL_MIN_INTERVAL_SEC=45
MERCADOLIVRE_PANEL_MAX_INTERVAL_SEC=180

# --- Anti-ban defaults (segundos) ---
DISPATCH_MIN_INTERVAL=45
DISPATCH_MAX_INTERVAL=180
DISPATCH_DAILY_LIMIT_PER_INSTANCE=300
DISPATCH_WINDOW_START=08
DISPATCH_WINDOW_END=22

# --- Click tracking (wrapper /r/:dispatchId) ---
CLICK_TRACKING_ENABLED=false
# URL pública desta API. Em produção: https://api.seu-dominio.com.br
PUBLIC_BASE_URL=http://localhost:3000

# --- Admin alerts (grupo WA para alertas de cookie expirado etc) ---
ADMIN_ALERT_GROUP_ID=

# --- CORS / Frontend ---
# URL(s) do frontend autorizadas a chamar esta API. Aceita "*" (libera tudo, dev),
# uma URL única, ou lista separada por vírgula. Em produção use exatamente:
#   WEB_ORIGIN_URL=https://seu-app.vercel.app,https://app.seu-dominio.com.br
WEB_ORIGIN_URL=http://localhost:3001
