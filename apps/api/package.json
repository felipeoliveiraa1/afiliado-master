{
  "name": "@afiliado-master/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -v NODE_ENV=development -- tsx watch src/index.ts",
    "dev:worker": "dotenv -v NODE_ENV=development -- tsx watch src/worker.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker.js",
    "prisma": "dotenv -e .env -- prisma",
    "prisma:gen": "prisma generate",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev",
    "fmt": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:dev": "docker compose -p afiliado-master --env-file .env -f docker-compose.yml up -d",
    "docker:isolated": "docker compose -p afiliado-master --env-file .env -f docker-compose.isolated.yml up -d --build",
    "docker:isolated:migrate": "docker compose -p afiliado-master --profile migrate --env-file .env -f docker-compose.isolated.yml run --rm migrate",
    "docker:supabase": "docker compose -p afiliado-master --env-file .env -f docker-compose.supabase.yml up -d --build",
    "docker:supabase:migrate": "docker compose -p afiliado-master --profile migrate --env-file .env -f docker-compose.supabase.yml run --rm migrate"
  },
  "dependencies": {
    "@afiliado-master/types": "0.0.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.66.5",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "envalid": "^8.0.0",
    "fastify": "^5.2.2",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.9.1",
    "nanoid": "^5.1.5",
    "node-cron": "^3.0.3",
    "openai": "^6.35.0",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "undici": "^7.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "prettier": "^3.4.2",
    "prisma": "^6.5.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
